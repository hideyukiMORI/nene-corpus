APP_ENV=local
APP_DEBUG=false
APP_NAME="NeNe Corpus"
NENE2_MACHINE_API_KEY=
PROBLEM_DETAILS_BASE_URL=https://nene-corpus.dev/problems/

# --- Admin auth (Phase 1+) — never commit real secrets ---
NENE2_LOCAL_JWT_SECRET=

# --- LLM (Phase 2+) — never commit real keys ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Consumer chat rate limits (Phase 2+) ---
NENE_CORPUS_CHAT_RATE_LIMIT_SESSION=20
NENE_CORPUS_CHAT_RATE_LIMIT_IP=60
NENE_CORPUS_CHAT_RATE_LIMIT_WINDOW=3600

# --- Optional upstream CMS (Phase 4) ---
NENE_RECORDS_API_BASE_URL=
NENE_RECORDS_BEARER_TOKEN=

# --- Database (host / PHPUnit default: SQLite) ---
DATABASE_URL=
DB_ENV=local
DB_ADAPTER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=var/nene_corpus.sqlite
DB_USER=nene_corpus
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Docker Compose overrides ---
# DB_ADAPTER=mysql
# DB_HOST=mysql
# DB_NAME=nene_corpus
# DB_USER=nene_corpus
# DB_PASSWORD=nene_corpus
# MYSQL_ROOT_PASSWORD=nene_corpus_root
#
# NENE_CORPUS_PORT=8080
# NENE_CORPUS_MYSQL_PORT=3307
#
# NENE_CORPUS_SKIP_MIGRATE=1
